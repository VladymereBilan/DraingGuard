# PlatformIO build output
.pio/

# VS Code - share only the recommended extension list
.vscode/*
!.vscode/extensions.json

# PlatformIO regenerates firmware/.vscode on every build and fills
# c_cpp_properties.json with absolute paths for this machine only.
firmware/.vscode/

# Local credentials, never committed
firmware/include/secrets.h
.env
tools/.env

# Node / Expo
node_modules/
app/.expo/
*.apk
*.aab

# OS cruft
.DS_Store
